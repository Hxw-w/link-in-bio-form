<h1>Add a new item</h1>

<form action="/make_a_new_item" method="post">
  <div>
    <label for="link">Link URL</label>
    <input id="link" type="text" name="link_url_param">
  </div>

  <div>
    <label for="des">Link Description</label>
    <input id="des" type="text" name="link_description_param">
  </div>

  <div>
    <label for="thumb">Thumbnail URL</label>
    <input id="thumb" type="text" name="thumbnail_url_param">
  </div>

  <button>Create item</button>
</form>
